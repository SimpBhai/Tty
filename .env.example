# ====================================================================
# AegisCord Environment Configuration (Render / Production / Dev)
# ====================================================================

# Super Administrator Credentials
# The Super Administrator is the root authority who can provision new user accounts,
# assign group administrators, reset credentials, and manage all server roles.
SUPER_ADMIN_USERNAME="superadmin"
SUPER_ADMIN_PASSWORD="change_this_secure_password_in_production"
SUPER_ADMIN_TAG="0001"

# Server Port (Render sets this dynamically at runtime)
PORT=3000
NODE_ENV="production"

# Optional App URL
APP_URL="https://your-app.onrender.com"
